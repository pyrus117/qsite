{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qsite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // "404-page" makes the asset layer answer unmatched paths itself, so every
    // worker-rendered URL must be listed here or it never reaches the worker
    "run_worker_first": [
      "/api/*",
      "/studio/api/*",
      "/sitemap.xml",
      "/blog/*"
    ],
    // serve public/404.html with a real 404 status instead of an empty body
    "not_found_handling": "404-page"
  },
  "vars": {
    "GITHUB_REPO": "pyrus117/qsite",
    "ADMIN_EMAILS": "nate@qyouthnz.com",
    // Set after the Access app exists (runbook step 4) — placeholder values fail closed
    "CF_ACCESS_TEAM_DOMAIN": "https://qyouth.cloudflareaccess.com",
    "CF_ACCESS_AUD": "5e5b7448e8d10c3690454ab9c8e966363e61b315902577a70d071280f328edae"
  }
}
